/** JWC ticket workbook and authenticated ticket app. Deploy as the user accessing the app. */
const TARGET_SPREADSHEET_ID = '1-9vgsLWZLjXDXYxb24oecuvYh8_C2Nr2NtXJ1RKxTE4';
const HEADERS = ['Ticket ID','Submitted','Date','Customer','Job number','Truck','Driver','Truck hours','Jeep','Booster','Tridem','Description','Updated','Billing quantity','Unit rate','Amount','Invoice number','Permits','Permit rate'];
function setupWorkbook() {
  const props = PropertiesService.getScriptProperties();
  const existing = props.getProperty('SPREADSHEET_ID');
  if (existing && existing !== TARGET_SPREADSHEET_ID) throw new Error('This script is already connected to a different workbook. No changes made.');
  if (existing) return SpreadsheetApp.openById(existing).getUrl();
  const book = SpreadsheetApp.openById(TARGET_SPREADSHEET_ID);
  for (const name of ['Ticket Log','Truck Log','Billing Data','Overview']) {
    if (book.getSheetByName(name)) throw new Error('A tab named '+name+' already exists. Setup stopped to preserve existing data.');
  }
  const log = book.insertSheet('Ticket Log');
  log.getRange(1,1,1,HEADERS.length).setValues([HEADERS]); log.setFrozenRows(1);
  log.getRange('A1:Q1').setFontWeight('bold').setBackground('#20252d').setFontColor('#ffffff');
  log.getRange('N1').setNote('Defaults to truck hours. Edit for flat or other charges; use 1 for a flat charge.');
  log.getRange('O1').setNote('Enter the agreed rate for this ticket. No rate is assumed.');
  log.getRange('Q1').setNote('Optional reference for later QuickBooks reconciliation.');
  log.getRange('N2:O1000').setBackground('#fff2cc'); log.getRange('Q2:Q1000').setBackground('#fff2cc');
  log.getRange('O2:P1000').setNumberFormat('$#,##0.00');
  log.getRange('N2:O1000').setDataValidation(SpreadsheetApp.newDataValidation().requireNumberGreaterThanOrEqualTo(0).setAllowInvalid(false).build());
  log.getRange('B2:B1000').setNumberFormat('yyyy-mm-dd hh:mm'); log.getRange('M2:M1000').setNumberFormat('yyyy-mm-dd hh:mm');
  log.getRange('A1:S1000').createFilter(); log.autoResizeColumns(1,19); log.setColumnWidth(12,320);
  props.setProperty('SPREADSHEET_ID',book.getId());
  refreshWorkbookDesign();
  console.log('Workbook: '+book.getUrl()); return book.getUrl();
}
function doGet(e) {
  const view=e && e.parameter && e.parameter.view==='maintenance'?'maintenance':'tickets';
  const html=HtmlService.createHtmlOutput(JWC_TICKET_HTML).getContent().replace('data-initial-view="tickets"','data-initial-view="'+view+'"');
  return HtmlService.createHtmlOutput(html).setTitle('JWC Field App').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');
}
function safeCell(value) { const s=String(value ?? '').slice(0,5000); return /^[=+@\-]/.test(s) ? "'"+s : s; }
function validateTicket(t) {
  if (!t || !/^[A-Za-z0-9_-]{1,100}$/.test(String(t.id)) || !/^\d{4}-\d{2}-\d{2}$/.test(String(t.date)) || !t.customer || !t.truck || t.hours === '' || !Number.isFinite(Number(t.hours)) || Number(t.hours)<0) throw new Error('Ticket is missing a valid ID, date, customer, truck, or hours.');
  for (const field of ['hourlyRate','permitRate']) {
    const value=t[field];
    if(value!==undefined && value!==null && value!=='' && (!/^(?:\d+(?:\.\d{1,2})?|\.\d{1,2})$/.test(String(value)) || !Number.isFinite(Number(value)))) throw new Error('Rates must be zero or positive amounts with no more than two decimal places.');
  }
  if(Object.prototype.hasOwnProperty.call(t,'permits') && typeof t.permits!=='boolean')throw new Error('Permits must be checked or unchecked.');
  if(t.permitRate!==undefined && t.permitRate!==null && t.permitRate!=='' && t.permits!==true)throw new Error('Check Permits before entering a permit charge.');
}
function ensurePermitColumns_(sheet) {
  if(sheet.getMaxColumns()<19)sheet.insertColumnsAfter(sheet.getMaxColumns(),19-sheet.getMaxColumns());
  const headers=sheet.getRange(1,18,1,2).getValues()[0];
  const expected=['Permits','Permit rate'];
  if(expected.some((name,i)=>headers[i]!=null && headers[i]!=='' && headers[i]!==name))throw new Error('Ticket Log columns R/S contain other data. No ticket was changed.');
  if(expected.some((name,i)=>headers[i]!==name)) {
    sheet.getRange(1,18,1,2).setValues([expected]).setBackground('#343a43').setFontColor('#f2f4f7').setFontWeight('bold');
    sheet.setColumnWidth(18,100);sheet.setColumnWidth(19,140);
    sheet.getRange('R2:R').setBackground('#161c24').setFontColor('#e5e7eb');
    sheet.getRange('S2:S').setNumberFormat('$#,##0.00').setBackground('#dce1e8').setFontColor('#101216');
  }
  const existingFilter=sheet.getFilter();
  if(existingFilter) {
    const range=existingFilter.getRange();
    if(range.getRow()!==1 || range.getColumn()!==1)throw new Error('Ticket Log filter must begin at A1. No ticket was changed.');
    if(range.getNumColumns()<19) {
      const criteria=[];
      for(let c=1;c<=range.getNumColumns();c++)criteria.push(existingFilter.getColumnFilterCriteria(c));
      const height=Math.max(range.getNumRows(),sheet.getLastRow());
      existingFilter.remove();
      const replacement=sheet.getRange(1,1,height,19).createFilter();
      criteria.forEach((criterion,index)=>{if(criterion)replacement.setColumnFilterCriteria(index+1,criterion);});
    }
  }
}
function saveTickets(tickets) {
  if (!Array.isArray(tickets) || !tickets.length || tickets.length>200) throw new Error('Send between 1 and 200 tickets.');
  tickets.forEach(validateTicket);
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('Run setupWorkbook first.');
  // Running as the visitor enforces the workbook sharing permissions for every request.
  const sheet=SpreadsheetApp.openById(id).getSheetByName('Ticket Log');
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try {
    ensurePermitColumns_(sheet);
    const count=sheet.getLastRow();
    const ids=count>1?sheet.getRange(2,1,count-1,1).getValues().flat().map(String):[];
    for (const t of tickets) {
      const idx=ids.indexOf(String(t.id)); const row=idx<0?sheet.getLastRow()+1:idx+2; const now=new Date();
      const submitted=idx<0?now:sheet.getRange(row,2).getValue();
      sheet.getRange(row,1,1,13).setValues([[String(t.id),submitted,safeCell(t.date),safeCell(t.customer),safeCell(t.job),safeCell(t.truck),safeCell(t.driver),Number(t.hours),!!t.jeep,!!t.booster,!!t.tridem,safeCell(t.work),now]]);
      // Manual billing quantity, rate and invoice assignment survive ticket updates.
      if (idx<0) { sheet.getRange(row,14).setFormula('=H'+row); ids.push(String(t.id)); }
      if(t.hourlyRate!==undefined && t.hourlyRate!==null && t.hourlyRate!=='')sheet.getRange(row,15).setValue(Number(t.hourlyRate));
      if(Object.prototype.hasOwnProperty.call(t,'permits')) {
        sheet.getRange(row,18).setValue(t.permits);
        if(!t.permits)sheet.getRange(row,19).setValue('');
        else if(t.permitRate!==undefined && t.permitRate!==null && t.permitRate!=='')sheet.getRange(row,19).setValue(Number(t.permitRate));
      } else if(idx<0)sheet.getRange(row,18).setValue(false);
      sheet.getRange(row,16).setFormula('=IF(OR(N'+row+'="",O'+row+'="",AND(R'+row+'=TRUE,S'+row+'="")),"",ROUND(N'+row+'*O'+row+'+IF(R'+row+'=TRUE,S'+row+',0),2))');
    }
    SpreadsheetApp.flush(); return {saved:tickets.length,ticketRatesPermits:true};
  } finally {lock.releaseLock();}
}

/** Maintenance submissions use the same signed-in user's workbook permissions as tickets. */
function maintenanceSheet_() {
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('The ticket workbook is not configured.');
  const book=SpreadsheetApp.openById(id);
  let sheet=book.getSheetByName('Maintenance Log');
  const headers=['Date','Truck','Service','Work done','Performed by','Odometer (km)','Record ID','Submitted','Updated'];
  if (sheet) {
    const actual=sheet.getRange(1,1,1,9).getValues()[0];
    if (actual.some((v,i)=>v!==headers[i])) throw new Error('Maintenance Log columns do not match. No data changed.');
    return sheet;
  }
  sheet=book.insertSheet('Maintenance Log');
  sheet.getRange(1,1,1,9).setValues([headers]);
  sheet.setFrozenRows(1); sheet.setHiddenGridlines(true); sheet.setTabColor('#aeb6c1');
  sheet.getRange(1,1,sheet.getMaxRows(),9).setFontFamily('Arial').setFontSize(12).setFontColor('#e5e7eb').applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY,true,false).setHeaderRowColor('#343a43').setFirstRowColor('#111418').setSecondRowColor('#1b2027');
  sheet.getRange('A1:I1').setFontColor('#f2f4f7').setFontWeight('bold').setWrap(true);
  sheet.setRowHeight(1,44); sheet.setRowHeights(2,sheet.getMaxRows()-1,40);
  [125,100,160,380,190,160,180,160,160].forEach((width,i)=>sheet.setColumnWidth(i+1,width));
  sheet.getRange('D2:D').setWrap(true); sheet.getRange('F2:F').setNumberFormat('#,##0');
  sheet.getRange('H2:I').setNumberFormat('yyyy-mm-dd hh:mm');
  sheet.hideColumns(7,3); sheet.getRange(1,1,sheet.getMaxRows(),9).createFilter();
  return sheet;
}
function validateMaintenance_(entry) {
  if (!entry || !/^[A-Za-z0-9_-]{1,100}$/.test(String(entry.id))) throw new Error('A valid maintenance ID is required.');
  const date=String(entry.date||'');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !Number.isFinite(Date.parse(date+'T00:00:00Z')) || new Date(date+'T00:00:00Z').toISOString().slice(0,10)!==date) throw new Error('Choose a valid service date.');
  for (const field of ['truck','service','work','performedBy']) if (typeof entry[field]!=='string' || !entry[field].trim() || entry[field].length>5000) throw new Error('Truck, service, work done and performed by are required.');
  if (entry.odometer!=='' && entry.odometer!=null && (!Number.isFinite(Number(entry.odometer)) || Number(entry.odometer)<0 || !Number.isInteger(Number(entry.odometer)))) throw new Error('Odometer must be a whole positive number or blank.');
}
function saveMaintenance(entry) {
  validateMaintenance_(entry);
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const sheet=maintenanceSheet_();
    const last=sheet.getLastRow();
    const ids=last>1?sheet.getRange(2,7,last-1,1).getValues().flat().map(String):[];
    const index=ids.indexOf(String(entry.id));
    const row=index<0?last+1:index+2; const now=new Date();
    const submitted=index<0?now:sheet.getRange(row,8).getValue();
    const odometer=entry.odometer==='' || entry.odometer==null?'':Number(entry.odometer);
    sheet.getRange(row,1,1,9).setValues([[safeCell(entry.date),safeCell(entry.truck),safeCell(entry.service),safeCell(entry.work),safeCell(entry.performedBy),odometer,String(entry.id),submitted,now]]);
    SpreadsheetApp.flush(); return {saved:1};
  } finally {lock.releaseLock();}
}

/** Receive form submissions from the JWC website without showing Google's hosted form UI. */
function doPost(e) {
  const allowed=['https://www.jwchauling.com','https://jwchauling.com'];
  let packet={},origin=allowed[0],result={type:'JWC_SUBMISSION_RESULT',ok:false};
  try {
    const raw=e && e.parameter && e.parameter.packet;
    if(typeof raw!=='string' || raw.length>50000)throw new Error('Invalid submission.');
    packet=JSON.parse(raw);
    if(!allowed.includes(packet.origin))throw new Error('Invalid app origin.');
    origin=packet.origin;
    if(!/^[A-Za-z0-9_-]{1,100}$/.test(String(packet.requestId||'')))throw new Error('Invalid request.');
    result.requestId=packet.requestId;
    result.id=packet.payload && packet.payload.id;
    if(packet.kind==='ticket'){saveTickets([packet.payload]);result.ticketRatesPermits=true;}
    else if(packet.kind==='maintenance')saveMaintenance(packet.payload);
    else throw new Error('Invalid submission type.');
    result.ok=true;
  } catch(error) {
    result.message='Google Sheets could not save this submission. It is still stored on your device; please retry.';
  }
  const json=JSON.stringify(result).replace(/</g,'\\u003c');
  const target=JSON.stringify(origin);
  return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.top.postMessage('+json+','+target+');</script></body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** Run once to upgrade the workbook to operational logs and QuickBooks preparation. */
function refreshWorkbookDesign() {
  const book = SpreadsheetApp.openById('1-9vgsLWZLjXDXYxb24oecuvYh8_C2Nr2NtXJ1RKxTE4');
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('JWC_DESIGN_VERSION') === '2') { console.log(book.getUrl()); return book.getUrl(); }
  const log = book.getSheetByName('Ticket Log');
  if (!log) throw new Error('Ticket Log is missing. Run setupWorkbook first.');
  const headers = log.getRange(1,1,1,17).getValues()[0];
  if (headers[0] !== 'Ticket ID' || headers[14] !== 'Unit rate') throw new Error('Ticket Log columns changed. No changes made.');
  // Archive derived views rather than overwriting any notes or values entered into them.
  for (const name of ['Truck Log','Invoicing']) {
    if (book.getSheetByName(name) && book.getSheetByName(name+' (previous)')) throw new Error('An archive already exists for '+name+'. No changes made.');
  }
  if (book.getSheetByName('Billing Data') || book.getSheetByName('Overview')) throw new Error('A redesigned view already exists. No changes made.');
  for (const name of ['Truck Log','Invoicing']) {
    const old = book.getSheetByName(name);
    if (old) { old.setName(name+' (previous)'); old.hideSheet(); }
  }
  const rows=log.getMaxRows();
  log.setHiddenGridlines(true);
  log.setFrozenRows(1);
  log.setFrozenColumns(1);
  log.setTabColor('#27374d');
  log.getRange(1,1,rows,17).setFontFamily('Arial').setFontSize(10).setFontColor('#243041').setVerticalAlignment('middle');
  log.getBandings().forEach(b=>b.remove());
  styleTable_(log,1,17,rows);
  log.getRange(2,14,rows-1,2).setBackground('#fff3d5');
  log.getRange('N1').setValue('Billable hours / quantity').setNote('Follows truck hours by default. Override only when billing differs.');
  log.getRange('O1').setValue('Unit rate').setNote('Manual entry: agreed rate for this ticket.');
  log.getRange('P1').setValue('Line amount');
  log.getRange('Q1').setValue('QB invoice reference').setNote('Optional reference for later QuickBooks reconciliation. This does not sync to QuickBooks.');
  log.getRange(2,15,rows-1,2).setNumberFormat('$#,##0.00');
  log.getRange(2,8,rows-1,1).setNumberFormat('0.00');
  log.getRange(2,14,rows-1,1).setNumberFormat('0.00');
  const widths=[190,155,120,240,145,100,180,110,75,85,85,360,155,155,120,135,190];
  widths.forEach((w,i)=>log.setColumnWidth(i+1,w));
  log.getRange(2,12,rows-1,1).setWrap(true);
  const existingRules=log.getConditionalFormatRules();
  existingRules.push(SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=AND($A2<>"",$O2="")').setBackground('#fff3d5').setRanges([log.getRange(2,15,rows-1,1)]).build());
  log.setConditionalFormatRules(existingRules);
  const trucks=book.insertSheet('Truck Log');
  viewHeader_(trucks,7,'TRUCK ACTIVITY','Live job history · sorted by truck, then newest job · source: Ticket Log');
  trucks.getRange('A3').setValue('TOTAL TICKETS'); trucks.getRange('B3').setFormula('=COUNTA(\'Ticket Log\'!A2:A)');
  trucks.getRange('D3').setValue('TRUCK HOURS'); trucks.getRange('E3').setFormula('=SUM(\'Ticket Log\'!H2:H)').setNumberFormat('0.00');
  trucks.getRange('A5').setFormula('=QUERY(\'Ticket Log\'!A:Q,"select F,C,G,D,E,H,A where A is not null order by F,C desc label F \'Truck\',C \'Date\',G \'Driver\',D \'Customer\',E \'Job number\',H \'Hours\',A \'Ticket ID\'",1)');
  styleTable_(trucks,5,7,trucks.getMaxRows()-4);
  [105,125,190,260,155,110,200].forEach((w,i)=>trucks.setColumnWidth(i+1,w));
  trucks.getRange('F6:F1000').setNumberFormat('0.00');
  trucks.getRange('A5:G1000').createFilter();
  const billing=book.insertSheet('Billing Data');
  viewHeader_(billing,11,'BILLING DATA','QuickBooks preparation · edit rates in Ticket Log · no invoices are issued here');
  billing.getRange('A3').setValue('UNPRICED TICKETS'); billing.getRange('C3').setFormula('=COUNTIFS(\'Ticket Log\'!A2:A,"<>",\'Ticket Log\'!O2:O,"")');
  billing.getRange('F3').setValue('PRICED VALUE'); billing.getRange('H3').setFormula('=SUM(\'Ticket Log\'!P2:P)').setNumberFormat('$#,##0.00');
  billing.getRange('A5').setFormula('=QUERY(\'Ticket Log\'!A:Q,"select D,A,C,F,H,N,O,P,E,L,Q where A is not null order by D,C desc label D \'Customer\',A \'Ticket ID\',C \'Date\',F \'Truck\',H \'Truck hours\',N \'Billable quantity\',O \'Unit rate\',P \'Line amount\',E \'Job number\',L \'Work description\',Q \'QB reference\'",1)');
  styleTable_(billing,5,11,billing.getMaxRows()-4);
  [260,200,125,100,115,140,125,145,155,400,190].forEach((w,i)=>billing.setColumnWidth(i+1,w));
  billing.getRange('G6:H1000').setNumberFormat('$#,##0.00'); billing.getRange('E6:F1000').setNumberFormat('0.00');
  billing.getRange('J6:J1000').setWrap(true); billing.getRange('A5:K1000').createFilter();
  buildOverview_(book,log,trucks,billing);
  props.setProperty('JWC_DESIGN_VERSION','2');
  book.setActiveSheet(book.getSheetByName('Overview')); book.moveActiveSheet(1); SpreadsheetApp.flush(); console.log(book.getUrl()); return book.getUrl();
}
function viewHeader_(sheet,columns,title,subtitle) {
  sheet.setHiddenGridlines(true);
  sheet.setFrozenRows(5);
  sheet.setTabColor('#61758e');
  sheet.getRange(1,1,sheet.getMaxRows(),columns).setFontFamily('Arial').setFontSize(10).setFontColor('#243041').setVerticalAlignment('middle');
  sheet.getRange(1,1,1,columns).merge().setValue('JWC  /  '+title).setBackground('#172331').setFontColor('#ffffff').setFontSize(20).setFontWeight('bold');
  sheet.getRange(2,1,1,columns).merge().setValue(subtitle).setFontColor('#64748b').setBackground('#eef2f6');
  sheet.getRange(3,1,1,columns).setBackground('#e2e8f0').setFontWeight('bold');
  sheet.setRowHeight(1,52); sheet.setRowHeight(2,34); sheet.setRowHeight(3,40); sheet.setRowHeight(4,14);
}
function styleTable_(sheet,startRow,columns,rows) {
  sheet.getRange(startRow,1,rows,columns).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY,true,false).setHeaderRowColor('#27374d').setFirstRowColor('#ffffff').setSecondRowColor('#f1f5f9');
  sheet.getRange(startRow,1,1,columns).setFontWeight('bold').setFontColor('#ffffff').setWrap(true);
  sheet.setRowHeight(startRow,40); sheet.setRowHeights(startRow+1,rows-1,34);
}

function buildOverview_(book,log,trucks,billing) {
  const sheet=book.insertSheet('Overview');
  sheet.setHiddenGridlines(true); sheet.setTabColor('#172331');
  sheet.setColumnWidths(1,12,100); sheet.setRowHeights(1,22,28);
  sheet.getRange('A1:L22').setBackground('#f1f5f9').setFontFamily('Arial').setFontColor('#243041');
  sheet.getRange('A1:L4').setBackground('#08090b');
  sheet.getRange('A1:D4').merge().setFormula('=IMAGE("https://raw.githubusercontent.com/JWCTrucking/jwc-website/main/assets/jwc-logo.png",1)').setHorizontalAlignment('center');
  sheet.getRange('E1:L2').merge().setValue('OPERATIONS OVERVIEW').setFontColor('#ffffff').setFontSize(23).setFontWeight('bold').setVerticalAlignment('bottom');
  sheet.getRange('E3:L4').merge().setValue('Tickets. Truck activity. Billing data.').setFontColor('#b8c3d1').setFontSize(13).setVerticalAlignment('top');
  const cards=[['A6:D6','A7:D8','TICKETS LOGGED',"=COUNTA('Ticket Log'!A2:A)"],['E6:H6','E7:H8','TOTAL TRUCK HOURS',"=SUM('Ticket Log'!H2:H)"],['I6:L6','I7:L8','TICKETS NEEDING RATES',`=COUNTIFS('Ticket Log'!A2:A,"<>",'Ticket Log'!O2:O,"")`]];
  for (const [label,value,title,formula] of cards) {
    sheet.getRange(label).merge().setValue(title).setFontSize(11).setFontColor('#64748b').setFontWeight('bold').setBackground('#ffffff').setHorizontalAlignment('center');
    sheet.getRange(value).merge().setFormula(formula).setFontSize(30).setFontWeight('bold').setBackground('#ffffff').setHorizontalAlignment('center').setVerticalAlignment('middle').setNumberFormat(title==='TOTAL TRUCK HOURS'?'0.00':'0');
  }
  const links=[['A11:D12',log,'TICKET LOG'],['E11:H12',trucks,'TRUCK ACTIVITY'],['I11:L12',billing,'BILLING DATA']];
  links.forEach(([range,target,title])=>sheet.getRange(range).merge().setFormula('=HYPERLINK("#gid='+target.getSheetId()+'","'+title+' →")').setBackground('#27374d').setFontColor('#ffffff').setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center').setVerticalAlignment('middle'));
  const notes=[['A13:D15','Enter and review tickets. Yellow cells are the editable billing quantity and rate.'],['E13:H15','Read job history by truck, driver and date. Hours update automatically from tickets.'],['I13:L15','Customer and job details, rates and amounts for billing preparation. QuickBooks is not connected yet.']];
  notes.forEach(([range,text])=>sheet.getRange(range).merge().setValue(text).setFontSize(11).setFontColor('#64748b').setWrap(true).setVerticalAlignment('top'));
  sheet.getRange('A18:L19').merge().setValue('HOW TO USE  •  Record the ticket → Review hours → Enter the agreed rate → Prepare data for QuickBooks').setBackground('#e2e8f0').setFontSize(12).setWrap(true).setVerticalAlignment('middle');
  sheet.getRange('A21:L22').merge().setValue('Live views update from Ticket Log. No customer invoices are created or sent from this workbook.').setFontSize(11).setFontColor('#64748b').setWrap(true);
}

