html{color-scheme:light}header,.savebar,.note,.subtitle{display:none!important}body{background:white;color:black}main{padding:0;max-width:none}.panel{border:0;background:white;padding:0}h1{margin-bottom:20px}legend,label,.field-label{color:black}.section-number,.optional{color:#555}.grid{grid-template-columns:1fr 1fr;gap:12px}fieldset{margin-bottom:20px;break-inside:avoid}input,select,textarea{color:black;border:0;border-bottom:1px solid #aaa;border-radius:0;background:white;padding:6px;min-height:32px}.checks{grid-template-columns:repeat(3,1fr)}.checks label{color:black;background:white;border:0;padding:4px}.checks label:has(input:checked){background:white}.checks input{accent-color:black}textarea{min-height:80px}.status{display:none}}\n[hidden]{display:none!important}.app-tabs{display:flex;gap:8px;margin:0 0 24px;padding:5px;border:1px solid #343a43;border-radius:10px;background:#14181e}.app-tabs a{flex:1;text-align:center;text-decoration:none;color:#aeb8c7;padding:14px 8px;border-radius:6px;font-weight:700;font-size:14px}.app-tabs a[aria-current=\"page\"]{background:linear-gradient(120deg,#9ca3ad,#f1f3f5,#a5adb7);color:#101216}\n@media print{.app-tabs{display:none}}\n\n/* Shared phone-app presentation for JWC form screens. */\nbody{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",system-ui,sans-serif;background:#0b0e12;color:#eef1f5}\n.form-appbar{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:72px minmax(0,1fr) 72px;align-items:center;gap:8px;padding:calc(10px + env(safe-area-inset-top)) 16px 10px;background:#0d1015f5;border-bottom:1px solid #2c333e;backdrop-filter:blur(14px)}\n.form-appbar .form-back{font-size:34px;line-height:1;text-decoration:none;min-height:44px;display:flex;align-items:center;padding:0;color:#e5e9ef;justify-self:start;min-width:44px}\n.form-appbar .screen-title{text-align:center;font-size:17px;font-weight:750;letter-spacing:-.02em;white-space:nowrap}\n.form-appbar .brand{width:72px;justify-self:end}.form-appbar .brand-logo{width:143%;max-width:none;height:auto;margin-left:-43%}\nmain{max-width:640px;margin:0 auto;padding:16px 16px calc(130px + env(safe-area-inset-bottom))}\n.heading,.subtitle{display:none}.panel{padding:0;border:0;border-radius:0;background:transparent}\n.app-tabs{display:none;margin:0 0 24px;padding:4px;gap:4px;border:1px solid #303945;border-radius:10px;background:#171c24}.app-tabs a{min-height:44px;padding:12px 8px;font-size:14px;border-radius:7px}\nfieldset{margin:0 0 24px}legend{font-size:17px;font-weight:700;margin-bottom:12px;letter-spacing:-.015em}.section-number{display:none}\n.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:0;border:1px solid #303945;border-radius:14px;background:#161c24;overflow:hidden}.grid>div{padding:15px 16px;border-bottom:1px solid #303945}.grid>div:last-child{border-bottom:0}.wide{grid-column:auto}\nlabel,.field-label{font-size:13px;font-weight:600;color:#b3bfce;margin:0 0 5px}.optional{color:#8492a5}\ninput,select,textarea{background:transparent;border:0;border-radius:0;padding:8px 0;min-height:40px;font-size:17px;color:#f2f4f8;width:100%;min-width:0;max-width:100%;scroll-margin-block:120px 150px}\ninput:focus-visible,select:focus-visible,textarea:focus-visible{outline:1px solid #aeb9c8;outline-offset:4px;border-radius:3px}input[type=date]{min-height:44px}select{padding-right:12px;color-scheme:dark}select option{background:#161c24}textarea{min-height:115px;line-height:1.55}\n.checks{grid-template-columns:1fr;gap:8px;margin-top:12px}.checks label{background:#202733;border-color:#455164;border-radius:8px;font-size:15px;font-weight:600;color:#e4eaf3;min-height:48px;padding:12px}.checks label:has(input:checked){background:#303946;border-color:#b5bfcd}.checks input{width:22px;height:22px;min-height:0;padding:0}\n.savebar{background:#0c1016f5;border-color:#343f4e;padding:12px 16px calc(12px + env(safe-area-inset-bottom));backdrop-filter:blur(14px)}.savebar-inner{max-width:608px}.savebar button{min-height:54px;border-radius:11px;font-size:17px;font-weight:800}.status{font-size:13px;margin-bottom:10px}.status:empty{display:none}\n@media(min-width:600px){main{padding-top:24px}.panel{padding:0}.grid{grid-template-columns:minmax(0,1fr);gap:0}.checks{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media print{.form-appbar,.app-tabs{display:none!important}.heading{display:block}.grid{border:0;background:white}.grid>div{padding:8px;border-color:#aaa}input,select,textarea,label,.field-label{color:black}.panel{padding:0}}\n\nbody.is-embedded .form-appbar{padding-top:10px}body.is-embedded .savebar{padding-bottom:12px}\n\n</style>\n</head>\n<body data-initial-view=\"tickets\">\n<header class=\"form-appbar\"><a class=\"form-back\" href=\"https://www.jwchauling.com/app/\" aria-label=\"Back to app\">\u2039</a><strong class=\"screen-title\" id=\"app-screen-title\">Field ticket</strong><div class=\"brand\"><img class=\"brand-logo\" src=\"data:image/png;base64,\" alt=\"JWC\"></div></header>\n<main>\n<nav class=\"app-tabs\" aria-label=\"App sections\"><a href=\"#tickets\" data-view=\"tickets\" aria-current=\"page\">Field ticket</a><a href=\"#maintenance\" data-view=\"maintenance\">Maintenance</a></nav>\n<div id=\"ticket-view\">\n\n<div class=\"heading\"><h1>Field Ticket</h1></div>\n<p class=\"subtitle\">Enter the job details, then submit your ticket.</p>\n<details class=\"note\"><summary>Google Sheets connected</summary><p>Tickets save on this device first, then send to the shared Google Sheet. Keep this page open until submitting completes.</p></details>\n<section class=\"panel\" aria-label=\"Ticket details\">\n<form id=\"form\">\n<fieldset><legend><span class=\"section-number\">01</span>Job details</legend><div class=\"grid\">\n<div><label for=\"date\">Date</label><input id=\"date\" type=\"date\" required></div>\n<div><label for=\"customer\">Customer</label><select id=\"customer\" required><option value=\"\">Select customer</option><option>Weaver Group Ltd</option><option>River Valley Energy Services</option><option>Ruel Concrete</option></select></div>\n<div class=\"wide\"><label for=\"job\">Job number <span class=\"optional\">Optional</span></label><input id=\"job\" placeholder=\"Enter job number\"></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">02</span>Truck &amp; driver</legend><div class=\"grid\">\n<div><label for=\"truck\">Truck number</label><select id=\"truck\" required><option value=\"\">Select truck</option><option>820</option><option>822</option><option>823</option><option>824</option></select></div>\n<div><label for=\"driver\">Driver name</label><input id=\"driver\" autocomplete=\"name\" placeholder=\"Enter driver name\" required></div>\n<div class=\"wide\"><label for=\"hours\">Truck hours</label><input id=\"hours\" type=\"number\" min=\"0\" step=\"0.25\" inputmode=\"decimal\" placeholder=\"e.g. 8.5\" required></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">03</span>Equipment &amp; work</legend><div class=\"grid\">\n<div class=\"wide\"><span class=\"field-label\" id=\"equipment-label\">Equipment used</span><div class=\"checks\" role=\"group\" aria-labelledby=\"equipment-label\"><label><input type=\"checkbox\" id=\"jeep\">Jeep</label><label><input type=\"checkbox\" id=\"booster\">Booster</label><label><input type=\"checkbox\" id=\"tridem\">Tridem</label></div></div>\n<div class=\"wide\"><label for=\"work\">Description of work <span class=\"optional\">Optional</span></label><textarea id=\"work\" placeholder=\"Describe the haul, locations, and any job notes\"></textarea></div>\n</div></fieldset>\n\n<fieldset><legend>Rates &amp; permits <span class=\"optional\">Optional</span></legend><div class=\"grid\">\n<div><label for=\"hourlyRate\">Hourly rate ($/hr) <span class=\"optional\">Optional</span></label><input id=\"hourlyRate\" type=\"number\" min=\"0\" step=\"0.01\" inputmode=\"decimal\" placeholder=\"Leave blank to enter in Sheets\"></div>\n<div><div class=\"checks\"><label><input type=\"checkbox\" id=\"permits\">Permits</label></div></div>\n<div id=\"permit-rate-field\" hidden><label for=\"permitRate\">Permit rate ($) <span class=\"optional\">Optional</span></label><input id=\"permitRate\" type=\"number\" min=\"0\" step=\"0.01\" inputmode=\"decimal\" placeholder=\"Permit amount for this ticket\" disabled></div>\n</div></fieldset>\n<div class=\"savebar\"><div class=\"savebar-inner\"><p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></p><button type=\"submit\">Submit</button></div></div>\n</form>\n</section>\n\n</div>\n<div id=\"maintenance-view\" hidden>\n<div class=\"heading\"><h1>Maintenance</h1></div>\n<p class=\"subtitle\">Record work done on a truck.</p>\n<section class=\"panel\" aria-label=\"Maintenance details\">\n<form id=\"maintenance-form\">\n<fieldset><legend>Service details</legend><div class=\"grid\">\n<div><label for=\"service-date\">Date work was done</label><input id=\"service-date\" type=\"date\" required></div>\n<div><label for=\"service-truck\">Truck number</label><input id=\"service-truck\" list=\"service-trucks\" placeholder=\"Enter truck number\" required><datalist id=\"service-trucks\"><option value=\"820\"><option value=\"822\"><option value=\"823\"><option value=\"824\"></datalist></div>\n<div><label for=\"service-type\">Service</label><select id=\"service-type\" required><option value=\"\">Select service</option><option>Oil change</option><option>Greasing</option><option>Inspection</option><option>Repair</option><option>Other</option></select></div>\n<div><label for=\"service-person\">Who did the work?</label><input id=\"service-person\" autocomplete=\"name\" placeholder=\"Name or shop\" required></div>\n<div class=\"wide\"><label for=\"service-odometer\">Odometer (km) <span class=\"optional\">Optional</span></label><input id=\"service-odometer\" type=\"number\" min=\"0\" step=\"1\" inputmode=\"numeric\" placeholder=\"Truck mileage at service\"></div>\n<div class=\"wide\"><label for=\"service-work\">Work done</label><textarea id=\"service-work\" placeholder=\"Oil change, filters replaced, repairs, or other details\" required></textarea></div>\n</div></fieldset>\n<div class=\"savebar\"><div class=\"savebar-inner\"><p class=\"status\" id=\"maintenance-status\" role=\"status\" aria-live=\"polite\"></p><button type=\"submit\">Submit</button></div></div>\n</form>\n</section>\n</div>\n</main>\n<script>\nconst $ = id => document.getElementById(id);\nconst key = 'jwc-tickets-v1';\nconst fields = ['date','customer','job','truck','driver','hours','work','hourlyRate','permitRate'];\nlet pendingId = null;\nfunction all() {\n  try { const data = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(data) ? data : []; }\n  catch { return []; }\n}\nfunction syncPermitField() {\n  $('permit-rate-field').hidden = !$('permits').checked;\n  $('permitRate').disabled = !$('permits').checked;\n  if (!$('permits').checked) $('permitRate').value = '';\n}\n$('permits').addEventListener('change',syncPermitField);\nfunction clearForm() {\n  $('form').reset();\n  syncPermitField();\n  const now = new Date();\n  $('date').value = [now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-');\n}\n/* SHEETS_ADAPTER_START */\nfunction deliverTicket(ticket, success, failure) {\n  google.script.run.withSuccessHandler(success).withFailureHandler(failure).saveTickets([ticket]);\n}\n/* SHEETS_ADAPTER_END */\n$('form').onsubmit = event => {\n  event.preventDefault();\n  const button = $('form').querySelector('[type=\"submit\"]');\n  if (button.disabled) return;\n  const ticket = {id:pendingId || crypto.randomUUID()};\n  fields.forEach(field => ticket[field] = $(field).value);\n  ['jeep','booster','tridem','permits'].forEach(field => ticket[field] = $(field).checked);\n  const tickets = all();\n  const index = tickets.findIndex(saved => saved.id === ticket.id);\n  if (index >= 0) tickets[index] = ticket; else tickets.push(ticket);\n  try { localStorage.setItem(key,JSON.stringify(tickets)); }\n  catch { $('status').textContent = 'Could not save on this device. Your form has been kept. Please try again.'; return; }\n  pendingId = ticket.id;\n  button.disabled = true;\n  button.textContent = 'Submitting\u2026';\n  $('status').textContent = 'Saving your ticket\u2026';\n  const finish = () => { button.disabled = false; button.textContent = 'Submit'; };\n  const failure = () => {\n    finish();\n    $('status').textContent = 'Saved on this device, but Google Sheets submission failed. Your form has been kept. Tap Submit to retry.';\n  };\n  try {\n    deliverTicket(ticket, result => {\n      pendingId = null;\n      clearForm();\n      finish();\n      $('status').textContent = result && result.localOnly\n        ? 'Saved on this device only. Google Sheets is not connected yet.'\n        : 'Submitted to Google Sheets. Ready for the next ticket.';\n    }, failure);\n  } catch { failure(); }\n};\nclearForm();\nfunction showAppView(view) {\n  const maintenance = view === 'maintenance';\n  $('app-screen-title').textContent = maintenance ? 'Maintenance' : 'Field ticket';\n  $('ticket-view').hidden = maintenance;\n  $('maintenance-view').hidden = !maintenance;\n  document.querySelectorAll('[data-view]').forEach(link => {\n    if (link.dataset.view === (maintenance ? 'maintenance' : 'tickets')) link.setAttribute('aria-current','page');\n    else link.removeAttribute('aria-current');\n  });\n  window.scrollTo(0,0);\n}\ndocument.querySelectorAll('[data-view]').forEach(link => link.onclick = event => {event.preventDefault();showAppView(link.dataset.view);});\nshowAppView(document.body.dataset.initialView);\nlet maintenanceId = null;\nfunction resetMaintenance() {\n  $('maintenance-form').reset();\n  $('service-date').value = $('date').value;\n}\n/* MAINTENANCE_ADAPTER_START */\nfunction deliverMaintenance(entry, success, failure) {\n  google.script.run.withSuccessHandler(success).withFailureHandler(failure).saveMaintenance(entry);\n}\n/* MAINTENANCE_ADAPTER_END */\n$('maintenance-form').onsubmit = event => {\n  event.preventDefault();\n  const button = $('maintenance-form').querySelector('[type=\"submit\"]');\n  if (button.disabled) return;\n  const entry={id:maintenanceId || crypto.randomUUID(),date:$('service-date').value,truck:$('service-truck').value.trim(),service:$('service-type').value,performedBy:$('service-person').value.trim(),odometer:$('service-odometer').value,work:$('service-work').value.trim()};\n  if (!entry.truck || !entry.performedBy || !entry.work) { $('maintenance-status').textContent='Enter the truck, who did the work, and the work done.'; return; }\n  try {\n    const stored=JSON.parse(localStorage.getItem('jwc-maintenance-v1')||'[]');\n    if (!Array.isArray(stored)) throw new Error('Invalid backup');\n    const index=stored.findIndex(item=>item.id===entry.id);\n    if(index<0)stored.push(entry);else stored[index]=entry;\n    localStorage.setItem('jwc-maintenance-v1',JSON.stringify(stored));\n  } catch { $('maintenance-status').textContent='Could not save a backup on this device. Your form has been kept.';return; }\n  maintenanceId=entry.id;button.disabled=true;button.textContent='Submitting\u2026';\n  $('maintenance-status').textContent='Sending maintenance record\u2026';\n  const finish=()=>{button.disabled=false;button.textContent='Submit';};\n  const failure=()=>{finish();$('maintenance-status').textContent='Not sent to Google Sheets. Your form and local backup have been kept. Tap Submit to retry.';};\n  try {deliverMaintenance(entry,()=>{maintenanceId=null;resetMaintenance();finish();$('maintenance-status').textContent='Maintenance submitted to Google Sheets.';},failure);}catch{failure();}\n};\nresetMaintenance();\n</script></body></html>\n";
