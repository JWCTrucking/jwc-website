/** JWC ticket workbook and authenticated ticket app. Deploy as the user accessing the app. */
const TARGET_SPREADSHEET_ID = '1-9vgsLWZLjXDXYxb24oecuvYh8_C2Nr2NtXJ1RKxTE4';
const HEADERS = ['Ticket ID','Submitted','Date','Customer','Job number','Truck','Driver','Truck hours','Jeep','Booster','Tridem','Description','Updated','Billing quantity','Unit rate','Amount','Invoice number'];
function setupWorkbook() {
  const props = PropertiesService.getScriptProperties();
  const existing = props.getProperty('SPREADSHEET_ID');
  if (existing && existing !== TARGET_SPREADSHEET_ID) throw new Error('This script is already connected to a different workbook. No changes made.');
  if (existing) return SpreadsheetApp.openById(existing).getUrl();
  const book = SpreadsheetApp.openById(TARGET_SPREADSHEET_ID);
  for (const name of ['Ticket Log','Truck Log','Invoicing']) {
    if (book.getSheetByName(name)) throw new Error('A tab named '+name+' already exists. Setup stopped to preserve existing data.');
  }
  const log = book.insertSheet('Ticket Log');
  log.getRange(1,1,1,HEADERS.length).setValues([HEADERS]); log.setFrozenRows(1);
  log.getRange('A1:Q1').setFontWeight('bold').setBackground('#20252d').setFontColor('#ffffff');
  log.getRange('N1').setNote('Defaults to truck hours. Edit for flat or other charges; use 1 for a flat charge.');
  log.getRange('O1').setNote('Enter the agreed rate for this ticket. No rate is assumed.');
  log.getRange('Q1').setNote('Assign the same invoice number to all tickets to include on that invoice.');
  log.getRange('N2:O1000').setBackground('#fff2cc'); log.getRange('Q2:Q1000').setBackground('#fff2cc');
  log.getRange('O2:P1000').setNumberFormat('$#,##0.00');
  log.getRange('N2:O1000').setDataValidation(SpreadsheetApp.newDataValidation().requireNumberGreaterThanOrEqualTo(0).setAllowInvalid(false).build());
  log.getRange('B2:B1000').setNumberFormat('yyyy-mm-dd hh:mm'); log.getRange('M2:M1000').setNumberFormat('yyyy-mm-dd hh:mm');
  log.getRange('A1:Q1000').createFilter(); log.autoResizeColumns(1,17); log.setColumnWidth(12,320);
  const trucks=book.insertSheet('Truck Log');
  trucks.getRange('A1').setFormula('=QUERY(\'Ticket Log\'!A:Q,"select C,F,G,H,D,E,A where A is not null order by C desc label C \'Date\',F \'Truck\',G \'Driver\',H \'Hours\',D \'Customer\',E \'Job\',A \'Ticket ID\'",1)');
  trucks.setFrozenRows(1); trucks.autoResizeColumns(1,7);
  const invoice=book.insertSheet('Invoicing');
  invoice.getRange('A1:H1').merge().setValue('JWC CONTRACTING LTD. — INVOICE').setFontWeight('bold').setFontSize(18);
  invoice.getRange('A2:A6').setValues([['Invoice number'],['Customer'],['Invoice date'],['Due date'],['Tax rate']]);
  invoice.getRange('B2').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInRange(log.getRange('Q2:Q1000'),true).setAllowInvalid(true).build());
  invoice.getRange('B3').setFormula('=IF(B2="","",IFERROR(TEXTJOIN(", ",TRUE,UNIQUE(FILTER(\'Ticket Log\'!D2:D,\'Ticket Log\'!Q2:Q=B2))),""))');
  invoice.getRange('B6').setValue(0).setNumberFormat('0.00%').setNote('Enter the applicable tax rate. Tax is not assumed.');
  invoice.getRange('B6').setDataValidation(SpreadsheetApp.newDataValidation().requireNumberBetween(0,1).setAllowInvalid(false).build());
  invoice.getRange('B2').setBackground('#fff2cc'); invoice.getRange('B4:B6').setBackground('#fff2cc');
  invoice.getRange('G4:G6').setValues([['Subtotal'],['Tax'],['Total']]);
  invoice.getRange('A7:H7').merge().setFormula('=IF(B2="","Select an invoice number above.",IF(COUNTIFS(\'Ticket Log\'!Q2:Q,B2,\'Ticket Log\'!O2:O,"")>0,"NOT READY: Enter a rate for every included ticket.",IF(IFERROR(COUNTA(UNIQUE(FILTER(\'Ticket Log\'!D2:D,\'Ticket Log\'!Q2:Q=B2))),0)>1,"NOT READY: Invoice number belongs to more than one customer.","Review all lines and tax before issuing.")))').setWrap(true);
  invoice.getRange('H4').setFormula('=IF(OR(B2="",LEFT(A7,9)="NOT READY"),"",SUM(H9:H))'); invoice.getRange('H5').setFormula('=IF(ISNUMBER(H4),H4*B6,"")'); invoice.getRange('H6').setFormula('=IF(ISNUMBER(H4),H4+H5,"")');
  invoice.getRange('A8:H8').setValues([['Date','Ticket ID','Job','Truck','Work','Quantity','Rate','Amount']]).setFontWeight('bold');
  invoice.getRange('A9').setFormula('=IF(B2="","",IFERROR(FILTER({\'Ticket Log\'!C2:C,\'Ticket Log\'!A2:A,\'Ticket Log\'!E2:E,\'Ticket Log\'!F2:F,\'Ticket Log\'!L2:L,\'Ticket Log\'!N2:P},\'Ticket Log\'!Q2:Q=B2,\'Ticket Log\'!A2:A<>""),""))');
  invoice.getRange('G9:H1000').setNumberFormat('$#,##0.00'); invoice.getRange('H4:H6').setNumberFormat('$#,##0.00');
  invoice.setColumnWidth(5,320); invoice.getRange('E9:E1000').setWrap(true); invoice.setFrozenRows(8);
  props.setProperty('SPREADSHEET_ID',book.getId());
  console.log('Workbook: '+book.getUrl()); return book.getUrl();
}
function doGet() { return HtmlService.createHtmlOutput(JWC_TICKET_HTML).setTitle('JWC Field Tickets').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover'); }
function safeCell(value) { const s=String(value ?? '').slice(0,5000); return /^[=+@\-]/.test(s) ? "'"+s : s; }
function validateTicket(t) {
  if (!t || !/^[A-Za-z0-9_-]{1,100}$/.test(String(t.id)) || !/^\d{4}-\d{2}-\d{2}$/.test(String(t.date)) || !t.customer || !t.truck || t.hours === '' || !Number.isFinite(Number(t.hours)) || Number(t.hours)<0) throw new Error('Ticket is missing a valid ID, date, customer, truck, or hours.');
}
function saveTickets(tickets) {
  if (!Array.isArray(tickets) || !tickets.length || tickets.length>200) throw new Error('Send between 1 and 200 tickets.');
  tickets.forEach(validateTicket);
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('Run setupWorkbook first.');
  // Running as the visitor enforces the workbook sharing permissions for every request.
  const sheet=SpreadsheetApp.openById(id).getSheetByName('Ticket Log');
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const count=sheet.getLastRow();
    const ids=count>1?sheet.getRange(2,1,count-1,1).getValues().flat().map(String):[];
    for (const t of tickets) {
      const idx=ids.indexOf(String(t.id)); const row=idx<0?sheet.getLastRow()+1:idx+2; const now=new Date();
      const submitted=idx<0?now:sheet.getRange(row,2).getValue();
      sheet.getRange(row,1,1,13).setValues([[String(t.id),submitted,safeCell(t.date),safeCell(t.customer),safeCell(t.job),safeCell(t.truck),safeCell(t.driver),Number(t.hours),!!t.jeep,!!t.booster,!!t.tridem,safeCell(t.work),now]]);
      // Manual billing quantity, rate and invoice assignment survive ticket updates.
      if (idx<0) { sheet.getRange(row,14).setFormula('=H'+row); ids.push(String(t.id)); }
      sheet.getRange(row,16).setFormula('=IF(OR(N'+row+'="",O'+row+'=""),"",N'+row+'*O'+row+')');
    }
    SpreadsheetApp.flush(); return {saved:tickets.length};
  } finally {lock.releaseLock();}
}

const JWC_TICKET_HTML = "<!doctype html>\n<html lang=\"en\">\n<head><base target=\"_top\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>JWC Field Tickets</title>\n<meta name=\"theme-color\" content=\"#0b0c0f\">\n<style>\n*{box-sizing:border-box}html{scroll-padding-top:20px;scroll-padding-bottom:150px;color-scheme:dark}body{margin:0;background:#0b0c0f;color:#eee;font:16px system-ui,Arial,sans-serif}a{color:#e5e7eb}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}header{padding:12px 16px;border-bottom:1px solid #30343b;display:flex;justify-content:space-between;align-items:center;gap:16px;background:#101216}header .brand{width:150px;overflow:hidden;mask-image:radial-gradient(ellipse,#000 40%,transparent 75%)}header .brand-logo{display:block;width:143%;height:auto;margin-left:-43%}header>a{padding:12px 4px;font-size:14px;text-decoration:none;font-weight:650}main{max-width:900px;margin:0 auto;padding:26px 16px 145px}.heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.heading a{font-size:14px;padding:12px 0;white-space:nowrap}h1{font-size:30px;letter-spacing:-.03em;margin:0}h2{font-size:22px;margin:0 0 18px}.subtitle{margin:8px 0 18px;color:#b8bec7;line-height:1.5}.note{padding:12px 14px;border:1px solid #3c424b;border-radius:8px;background:#171b21;color:#c4cad3;font-size:13px;line-height:1.6;margin:0 0 22px}.note summary{cursor:pointer;font-weight:650;min-height:24px}.note p{margin:10px 0 0}.panel{padding:20px 16px;border:1px solid #343a43;border-radius:12px;background:#13161b}fieldset{border:0;padding:0;margin:0 0 28px;min-width:0}fieldset:last-of-type{margin-bottom:0}legend{padding:0;margin-bottom:18px;color:#f2f3f5;font-size:18px;font-weight:750;width:100%}.section-number{color:#919aa8;font-size:12px;letter-spacing:.1em;margin-right:10px}.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}.grid>div{min-width:0}label,.field-label{display:block;font-size:14px;color:#dce1e8;font-weight:650;margin-bottom:8px}.optional{font-weight:400;color:#959fac;font-size:12px}input,select,textarea{scroll-margin-block:24px 150px;display:block;min-width:0;max-width:100%;width:100%;min-height:52px;background:#20252d;color:#fff;border:1px solid #525d6c;border-radius:8px;padding:14px 12px;font-size:16px}input[type=date]{appearance:none;-webkit-appearance:none;min-height:54px}textarea{min-height:140px;resize:vertical;line-height:1.5}input::placeholder,textarea::placeholder{color:#9ba5b2;opacity:1}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #e0e5ec;outline-offset:3px}.wide{grid-column:1/-1}.checks{display:grid;grid-template-columns:1fr;gap:10px}.checks label{display:flex;align-items:center;gap:12px;margin:0;padding:13px 14px;min-height:52px;border:1px solid #525d6c;border-radius:8px;background:#20252d;cursor:pointer}.checks label:has(input:checked){border-color:#dde3ec;background:#303844}.checks input{appearance:auto;width:22px;height:22px;min-height:0;margin:0;flex-shrink:0;accent-color:#dce2eb}button{min-height:48px;padding:13px 16px;border:0;border-radius:8px;font-weight:750;cursor:pointer;background:linear-gradient(120deg,#9ca3ad,#f1f3f5,#a5adb7);color:#101216}.secondary{background:#222831;color:#e8ecf2;border:1px solid #525d6c}.tools{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}.tools button:last-child{grid-column:1/-1}.savebar{position:fixed;left:0;right:0;bottom:0;z-index:5;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#101216f5;border-top:1px solid #454e5b}.savebar-inner{max-width:868px;margin:auto}.savebar button{width:100%;min-height:54px;font-size:16px}.status{font-size:13px;line-height:1.45;color:#c3e5c8;margin:0 0 10px}.status:empty{display:none}#history{margin-top:28px;scroll-margin-top:20px}#list{color:#b8c1cd;line-height:1.5}.item{border-top:1px solid #343d49;padding:16px 0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center}.item:last-child{padding-bottom:0}.ticket-details{min-width:0;overflow-wrap:anywhere}.ticket-details strong{display:block;color:#f1f3f5;font-size:16px}.ticket-details small{display:block;color:#aab4c2;margin-top:5px;font-size:13px}.item button{min-width:64px}.empty{margin:0;color:#aab4c2;font-size:14px}\n@media(min-width:600px){main{padding-top:36px}.panel{padding:26px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.checks{grid-template-columns:repeat(3,minmax(0,1fr))}.tools{grid-template-columns:repeat(3,1fr)}.tools button:last-child{grid-column:auto}header{padding:12px max(24px,calc((100vw - 868px)/2))}}\n@media print{html{color-scheme:light}header,.savebar,.tools,#history,.note,.heading a,.subtitle{display:none!important}body{background:white;color:black}main{padding:0;max-width:none}.panel{border:0;background:white;padding:0}h1{margin-bottom:20px}legend,label,.field-label{color:black}.section-number,.optional{color:#555}.grid{grid-template-columns:1fr 1fr;gap:12px}fieldset{margin-bottom:20px;break-inside:avoid}input,select,textarea{color:black;border:0;border-bottom:1px solid #aaa;border-radius:0;background:white;padding:6px;min-height:32px}.checks{grid-template-columns:repeat(3,1fr)}.checks label{color:black;background:white;border:0;padding:4px}.checks label:has(input:checked){background:white}.checks input{accent-color:black}textarea{min-height:80px}.status{display:none}}\n</style>\n</head>\n<body>\n<header><div class=\"brand\"><img class=\"brand-logo\" src=\"https://www.jwchauling.com/assets/jwc-logo.png\" alt=\"JWC Contracting Ltd.\"></div><a href=\"https://www.jwchauling.com/\">Back to website</a></header>\n<main>\n<div class=\"heading\"><h1>Field Ticket</h1><a href=\"#history\">Saved tickets</a></div>\n<p class=\"subtitle\">Enter the job details, then save your ticket.</p>\n<details class=\"note\"><summary>Google Sheets connected</summary><p>Tickets save on this device first, then send to the shared Google Sheet. Keep this page open until sending completes.</p></details>\n<section class=\"panel\" aria-label=\"Ticket details\">\n<form id=\"form\">\n<fieldset><legend><span class=\"section-number\">01</span>Job details</legend><div class=\"grid\">\n<div><label for=\"date\">Date</label><input id=\"date\" type=\"date\" required></div>\n<div><label for=\"customer\">Customer</label><select id=\"customer\" required><option value=\"\">Select customer</option><option>Weaver Group Ltd</option><option>River Valley Energy Services</option><option>Ruel Concrete</option></select></div>\n<div class=\"wide\"><label for=\"job\">Job number <span class=\"optional\">Optional</span></label><input id=\"job\" placeholder=\"Enter job number\"></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">02</span>Truck &amp; driver</legend><div class=\"grid\">\n<div><label for=\"truck\">Truck number</label><select id=\"truck\" required><option value=\"\">Select truck</option><option>820</option><option>822</option><option>823</option><option>824</option></select></div>\n<div><label for=\"driver\">Driver name</label><select id=\"driver\"><option>Jordan Cowan</option></select></div>\n<div class=\"wide\"><label for=\"hours\">Truck hours</label><input id=\"hours\" type=\"number\" min=\"0\" step=\"0.25\" inputmode=\"decimal\" placeholder=\"e.g. 8.5\" required></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">03</span>Equipment &amp; work</legend><div class=\"grid\">\n<div class=\"wide\"><span class=\"field-label\" id=\"equipment-label\">Equipment used</span><div class=\"checks\" role=\"group\" aria-labelledby=\"equipment-label\"><label><input type=\"checkbox\" id=\"jeep\">Jeep</label><label><input type=\"checkbox\" id=\"booster\">Booster</label><label><input type=\"checkbox\" id=\"tridem\">Tridem</label></div></div>\n<div class=\"wide\"><label for=\"work\">Description of work <span class=\"optional\">Optional</span></label><textarea id=\"work\" placeholder=\"Describe the haul, locations, and any job notes\"></textarea></div>\n</div></fieldset>\n<div class=\"tools\"><button type=\"button\" class=\"secondary\" id=\"clear\">New ticket</button><button type=\"button\" class=\"secondary\" onclick=\"window.print()\">Print / PDF</button><button type=\"button\" class=\"secondary\" id=\"csv\">Export CSV</button></div>\n<div class=\"savebar\"><div class=\"savebar-inner\"><p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></p><button type=\"submit\">Save ticket</button></div></div>\n</form>\n</section>\n<section class=\"panel\" id=\"history\"><h2>Saved tickets</h2><div id=\"list\"></div></section>\n</main>\n<script>const $=id=>document.getElementById(id),key='jwc-tickets-v1';let editing=null;const fields=['date','customer','job','truck','driver','hours','work'];function all(){try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return []}}function saveAll(a){localStorage.setItem(key,JSON.stringify(a))}function reset(){editing=null;$('form').reset();$('date').value=new Date().toLocaleDateString('en-CA');$('status').textContent=''}function render(){const a=all();$('list').replaceChildren();if(!a.length){$('list').textContent='No saved tickets yet.';return}a.slice().reverse().forEach(t=>{let d=document.createElement('div');d.className='item';let s=document.createElement('div');s.className='ticket-details';let title=document.createElement('strong');title.textContent=t.customer;let meta=document.createElement('small');meta.textContent=t.date+' \u00b7 Truck '+t.truck+' \u00b7 '+t.hours+' hrs';s.append(title,meta);let b=document.createElement('button');b.textContent='Open';b.onclick=()=>{editing=t.id;fields.forEach(k=>$(k).value=t[k]??'');['jeep','booster','tridem'].forEach(k=>$(k).checked=!!t[k]);window.scrollTo(0,0)};d.append(s,b);$('list').append(d)})}$('form').onsubmit=e=>{e.preventDefault();let t={id:editing||crypto.randomUUID()};fields.forEach(k=>t[k]=$(k).value);['jeep','booster','tridem'].forEach(k=>t[k]=$(k).checked);let a=all(),i=a.findIndex(x=>x.id===t.id);if(i>=0)a[i]=t;else a.push(t);try{saveAll(a);editing=t.id;$('status').textContent='Saved on this device. Sending to Google Sheets\u2026';render();google.script.run.withSuccessHandler(()=>{$('status').textContent='Saved to Google Sheets.'}).withFailureHandler(()=>{$('status').textContent='Saved on this device; Sheets upload failed. Check your Google account access and press Save ticket to retry.'}).saveTickets([t])}catch{$('status').textContent='Could not save ticket on this device.'}};$('clear').onclick=reset;$('csv').onclick=()=>{let a=all();if(!a.length)return alert('No saved tickets');let cols=['date','customer','job','truck','driver','hours','jeep','booster','tridem','work'];let csv=[cols,...a.map(t=>cols.map(k=>t[k]??''))].map(r=>r.map(v=>'\"'+String(v).replace(/\"/g,'\"\"')+'\"').join(',')).join('\\r\\n');let u=URL.createObjectURL(new Blob([csv],{type:'text/csv'})),link=document.createElement('a');link.href=u;link.download='JWC-tickets.csv';link.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};reset();render();</script></body></html>";
