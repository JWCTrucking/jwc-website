function doGet(e) {
  const view=e && e.parameter && e.parameter.view==='maintenance'?'maintenance':'tickets';
  const html=HtmlService.createHtmlOutput(JWC_TICKET_HTML).getContent().replace('data-initial-view="tickets"','data-initial-view="'+view+'"');
  return HtmlService.createHtmlOutput(html).setTitle('JWC Field App').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');
}
function safeCell(value) { const s=String(value ?? '').slice(0,5000); return /^[=+@\-]/.test(s) ? "'"+s : s; }
function validateTicket(t) {
  if (!t || !/^[A-Za-z0-9_-]{1,100}$/.test(String(t.id)) || !/^\d{4}-\d{2}-\d{2}$/.test(String(t.date)) || !t.customer || !t.truck || t.hours === '' || !Number.isFinite(Number(t.hours)) || Number(t.hours)<0) throw new Error('Ticket is missing a valid ID, date, customer, truck, or hours.');
}
function saveTickets(tickets) {
  if (!Array.isArray(tickets) || !tickets.length || tickets.length>200) throw new Error('Send between 1 and 200 tickets.');
  tickets.forEach(validateTicket);
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('Run setupWorkbook first.');
  // Running as the visitor enforces the workbook sharing permissions for every request.
  const sheet=SpreadsheetApp.openById(id).getSheetByName('Ticket Log');
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const count=sheet.getLastRow();
    const ids=count>1?sheet.getRange(2,1,count-1,1).getValues().flat().map(String):[];
    for (const t of tickets) {
      const idx=ids.indexOf(String(t.id)); const row=idx<0?sheet.getLastRow()+1:idx+2; const now=new Date();
      const submitted=idx<0?now:sheet.getRange(row,2).getValue();
      sheet.getRange(row,1,1,13).setValues([[String(t.id),submitted,safeCell(t.date),safeCell(t.customer),safeCell(t.job),safeCell(t.truck),safeCell(t.driver),Number(t.hours),!!t.jeep,!!t.booster,!!t.tridem,safeCell(t.work),now]]);
      // Manual billing quantity, rate and invoice assignment survive ticket updates.
      if (idx<0) { sheet.getRange(row,14).setFormula('=H'+row); ids.push(String(t.id)); }
      sheet.getRange(row,16).setFormula('=IF(OR(N'+row+'="",O'+row+'=""),"",N'+row+'*O'+row+')');
    }
    SpreadsheetApp.flush(); return {saved:tickets.length};
  } finally {lock.releaseLock();}
}

/** Maintenance submissions use the same signed-in user's workbook permissions as tickets. */
function maintenanceSheet_() {
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('The ticket workbook is not configured.');
  const book=SpreadsheetApp.openById(id);
  let sheet=book.getSheetByName('Maintenance Log');
  const headers=['Date','Truck','Service','Work done','Performed by','Odometer (km)','Record ID','Submitted','Updated'];
  if (sheet) {
    const actual=sheet.getRange(1,1,1,9).getValues()[0];
    if (actual.some((v,i)=>v!==headers[i])) throw new Error('Maintenance Log columns do not match. No data changed.');
    return sheet;
  }
  sheet=book.insertSheet('Maintenance Log');
  sheet.getRange(1,1,1,9).setValues([headers]);
  sheet.setFrozenRows(1); sheet.setHiddenGridlines(true); sheet.setTabColor('#aeb6c1');
  sheet.getRange(1,1,sheet.getMaxRows(),9).setFontFamily('Arial').setFontSize(12).setFontColor('#e5e7eb').applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY,true,false).setHeaderRowColor('#343a43').setFirstRowColor('#111418').setSecondRowColor('#1b2027');
  sheet.getRange('A1:I1').setFontColor('#f2f4f7').setFontWeight('bold').setWrap(true);
  sheet.setRowHeight(1,44); sheet.setRowHeights(2,sheet.getMaxRows()-1,40);
  [125,100,160,380,190,160,180,160,160].forEach((width,i)=>sheet.setColumnWidth(i+1,width));
  sheet.getRange('D2:D').setWrap(true); sheet.getRange('F2:F').setNumberFormat('#,##0');
  sheet.getRange('H2:I').setNumberFormat('yyyy-mm-dd hh:mm');
  sheet.hideColumns(7,3); sheet.getRange(1,1,sheet.getMaxRows(),9).createFilter();
  return sheet;
}
function validateMaintenance_(entry) {
  if (!entry || !/^[A-Za-z0-9_-]{1,100}$/.test(String(entry.id))) throw new Error('A valid maintenance ID is required.');
  const date=String(entry.date||'');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !Number.isFinite(Date.parse(date+'T00:00:00Z')) || new Date(date+'T00:00:00Z').toISOString().slice(0,10)!==date) throw new Error('Choose a valid service date.');
  for (const field of ['truck','service','work','performedBy']) if (typeof entry[field]!=='string' || !entry[field].trim() || entry[field].length>5000) throw new Error('Truck, service, work done and performed by are required.');
  if (entry.odometer!=='' && entry.odometer!=null && (!Number.isFinite(Number(entry.odometer)) || Number(entry.odometer)<0 || !Number.isInteger(Number(entry.odometer)))) throw new Error('Odometer must be a whole positive number or blank.');
}
function saveMaintenance(entry) {
  validateMaintenance_(entry);
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const sheet=maintenanceSheet_();
    const last=sheet.getLastRow();
    const ids=last>1?sheet.getRange(2,7,last-1,1).getValues().flat().map(String):[];
    const index=ids.indexOf(String(entry.id));
    const row=index<0?last+1:index+2; const now=new Date();
    const submitted=index<0?now:sheet.getRange(row,8).getValue();
    const odometer=entry.odometer==='' || entry.odometer==null?'':Number(entry.odometer);
    sheet.getRange(row,1,1,9).setValues([[safeCell(entry.date),safeCell(entry.truck),safeCell(entry.service),safeCell(entry.work),safeCell(entry.performedBy),odometer,String(entry.id),submitted,now]]);
    SpreadsheetApp.flush(); return {saved:1};
  } finally {lock.releaseLock();}
}

const JWC_TICKET_HTML = "<!doctype html>\n<html lang=\"en\">\n<head><base target=\"_top\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>JWC Field App</title>\n\n<meta name=\"theme-color\" content=\"#0b0c0f\">\n<style>\n*{box-sizing:border-box}html{scroll-padding-top:20px;scroll-padding-bottom:150px;color-scheme:dark}body{margin:0;background:#0b0c0f;color:#eee;font:16px system-ui,Arial,sans-serif}a{color:#e5e7eb}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}header{padding:12px 16px;border-bottom:1px solid #30343b;display:flex;justify-content:space-between;align-items:center;gap:16px;background:#101216}header .brand{width:150px;overflow:hidden;mask-image:radial-gradient(ellipse,#000 40%,transparent 75%)}header .brand-logo{display:block;width:143%;height:auto;margin-left:-43%}header>a{padding:12px 4px;font-size:14px;text-decoration:none;font-weight:650}main{max-width:900px;margin:0 auto;padding:26px 16px 145px}.heading{display:flex;align-items:center;justify-content:space-between;gap:16px}h1{font-size:30px;letter-spacing:-.03em;margin:0}h2{font-size:22px;margin:0 0 18px}.subtitle{margin:8px 0 18px;color:#b8bec7;line-height:1.5}.note{padding:12px 14px;border:1px solid #3c424b;border-radius:8px;background:#171b21;color:#c4cad3;font-size:13px;line-height:1.6;margin:0 0 22px}.note summary{cursor:pointer;font-weight:650;min-height:24px}.note p{margin:10px 0 0}.panel{padding:20px 16px;border:1px solid #343a43;border-radius:12px;background:#13161b}fieldset{border:0;padding:0;margin:0 0 28px;min-width:0}fieldset:last-of-type{margin-bottom:0}legend{padding:0;margin-bottom:18px;color:#f2f3f5;font-size:18px;font-weight:750;width:100%}.section-number{color:#919aa8;font-size:12px;letter-spacing:.1em;margin-right:10px}.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}.grid>div{min-width:0}label,.field-label{display:block;font-size:14px;color:#dce1e8;font-weight:650;margin-bottom:8px}.optional{font-weight:400;color:#959fac;font-size:12px}input,select,textarea{scroll-margin-block:24px 150px;display:block;min-width:0;max-width:100%;width:100%;min-height:52px;background:#20252d;color:#fff;border:1px solid #525d6c;border-radius:8px;padding:14px 12px;font-size:16px}input[type=date]{appearance:none;-webkit-appearance:none;min-height:54px}textarea{min-height:140px;resize:vertical;line-height:1.5}input::placeholder,textarea::placeholder{color:#9ba5b2;opacity:1}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #e0e5ec;outline-offset:3px}.wide{grid-column:1/-1}.checks{display:grid;grid-template-columns:1fr;gap:10px}.checks label{display:flex;align-items:center;gap:12px;margin:0;padding:13px 14px;min-height:52px;border:1px solid #525d6c;border-radius:8px;background:#20252d;cursor:pointer}.checks label:has(input:checked){border-color:#dde3ec;background:#303844}.checks input{appearance:auto;width:22px;height:22px;min-height:0;margin:0;flex-shrink:0;accent-color:#dce2eb}button:disabled{opacity:.7;cursor:wait}button{min-height:48px;padding:13px 16px;border:0;border-radius:8px;font-weight:750;cursor:pointer;background:linear-gradient(120deg,#9ca3ad,#f1f3f5,#a5adb7);color:#101216}.savebar{position:fixed;left:0;right:0;bottom:0;z-index:5;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#101216f5;border-top:1px solid #454e5b}.savebar-inner{max-width:868px;margin:auto}.savebar button{width:100%;min-height:54px;font-size:16px}.status{font-size:13px;line-height:1.45;color:#c3e5c8;margin:0 0 10px}.status:empty{display:none}\n@media(min-width:600px){main{padding-top:36px}.panel{padding:26px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.checks{grid-template-columns:repeat(3,minmax(0,1fr))}header{padding:12px max(24px,calc((100vw - 868px)/2))}}\n@media print{html{color-scheme:light}header,.savebar,.note,.subtitle{display:none!important}body{background:white;color:black}main{padding:0;max-width:none}.panel{border:0;background:white;padding:0}h1{margin-bottom:20px}legend,label,.field-label{color:black}.section-number,.optional{color:#555}.grid{grid-template-columns:1fr 1fr;gap:12px}fieldset{margin-bottom:20px;break-inside:avoid}input,select,textarea{color:black;border:0;border-bottom:1px solid #aaa;border-radius:0;background:white;padding:6px;min-height:32px}.checks{grid-template-columns:repeat(3,1fr)}.checks label{color:black;background:white;border:0;padding:4px}.checks label:has(input:checked){background:white}.checks input{accent-color:black}textarea{min-height:80px}.status{display:none}}\n[hidden]{display:none!important}.app-tabs{display:flex;gap:8px;margin:0 0 24px;padding:5px;border:1px solid #343a43;border-radius:10px;background:#14181e}.app-tabs a{flex:1;text-align:center;text-decoration:none;color:#aeb8c7;padding:14px 8px;border-radius:6px;font-weight:700;font-size:14px}.app-tabs a[aria-current=\"page\"]{background:linear-gradient(120deg,#9ca3ad,#f1f3f5,#a5adb7);color:#101216}\n@media print{.app-tabs{display:none}}\n</style>\n</head>\n<body data-initial-view=\"tickets\">\n<header><div class=\"brand\"><img class=\"brand-logo\" src=\"https://www.jwchauling.com/assets/jwc-logo.png\" alt=\"JWC Contracting Ltd.\"></div><a href=\"https://www.jwchauling.com/\">Back to website</a></header>\n<main>\n<nav class=\"app-tabs\" aria-label=\"App sections\"><a href=\"#tickets\" data-view=\"tickets\" aria-current=\"page\">Field ticket</a><a href=\"#maintenance\" data-view=\"maintenance\">Maintenance</a></nav>\n<div id=\"ticket-view\">\n\n<div class=\"heading\"><h1>Field Ticket</h1></div>\n<p class=\"subtitle\">Enter the job details, then submit your ticket.</p>\n<details class=\"note\"><summary>Google Sheets connected</summary><p>Tickets save on this device first, then send to the shared Google Sheet. Keep this page open until submitting completes.</p></details>\n<section class=\"panel\" aria-label=\"Ticket details\">\n<form id=\"form\">\n<fieldset><legend><span class=\"section-number\">01</span>Job details</legend><div class=\"grid\">\n<div><label for=\"date\">Date</label><input id=\"date\" type=\"date\" required></div>\n<div><label for=\"customer\">Customer</label><select id=\"customer\" required><option value=\"\">Select customer</option><option>Weaver Group Ltd</option><option>River Valley Energy Services</option><option>Ruel Concrete</option></select></div>\n<div class=\"wide\"><label for=\"job\">Job number <span class=\"optional\">Optional</span></label><input id=\"job\" placeholder=\"Enter job number\"></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">02</span>Truck &amp; driver</legend><div class=\"grid\">\n<div><label for=\"truck\">Truck number</label><select id=\"truck\" required><option value=\"\">Select truck</option><option>820</option><option>822</option><option>823</option><option>824</option></select></div>\n<div><label for=\"driver\">Driver name</label><select id=\"driver\"><option>Jordan Cowan</option></select></div>\n<div class=\"wide\"><label for=\"hours\">Truck hours</label><input id=\"hours\" type=\"number\" min=\"0\" step=\"0.25\" inputmode=\"decimal\" placeholder=\"e.g. 8.5\" required></div>\n</div></fieldset>\n<fieldset><legend><span class=\"section-number\">03</span>Equipment &amp; work</legend><div class=\"grid\">\n<div class=\"wide\"><span class=\"field-label\" id=\"equipment-label\">Equipment used</span><div class=\"checks\" role=\"group\" aria-labelledby=\"equipment-label\"><label><input type=\"checkbox\" id=\"jeep\">Jeep</label><label><input type=\"checkbox\" id=\"booster\">Booster</label><label><input type=\"checkbox\" id=\"tridem\">Tridem</label></div></div>\n<div class=\"wide\"><label for=\"work\">Description of work <span class=\"optional\">Optional</span></label><textarea id=\"work\" placeholder=\"Describe the haul, locations, and any job notes\"></textarea></div>\n</div></fieldset>\n\n<div class=\"savebar\"><div class=\"savebar-inner\"><p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></p><button type=\"submit\">Submit</button></div></div>\n</form>\n</section>\n\n</div>\n<div id=\"maintenance-view\" hidden>\n<div class=\"heading\"><h1>Maintenance</h1></div>\n<p class=\"subtitle\">Record work done on a truck.</p>\n<section class=\"panel\" aria-label=\"Maintenance details\">\n<form id=\"maintenance-form\">\n<fieldset><legend>Service details</legend><div class=\"grid\">\n<div><label for=\"service-date\">Date work was done</label><input id=\"service-date\" type=\"date\" required></div>\n<div><label for=\"service-truck\">Truck number</label><input id=\"service-truck\" list=\"service-trucks\" placeholder=\"Enter truck number\" required><datalist id=\"service-trucks\"><option value=\"820\"><option value=\"822\"><option value=\"823\"><option value=\"824\"></datalist></div>\n<div><label for=\"service-type\">Service</label><select id=\"service-type\" required><option value=\"\">Select service</option><option>Oil change</option><option>Greasing</option><option>Inspection</option><option>Repair</option><option>Other</option></select></div>\n<div><label for=\"service-person\">Who did the work?</label><input id=\"service-person\" autocomplete=\"name\" placeholder=\"Name or shop\" required></div>\n<div class=\"wide\"><label for=\"service-odometer\">Odometer (km) <span class=\"optional\">Optional</span></label><input id=\"service-odometer\" type=\"number\" min=\"0\" step=\"1\" inputmode=\"numeric\" placeholder=\"Truck mileage at service\"></div>\n<div class=\"wide\"><label for=\"service-work\">Work done</label><textarea id=\"service-work\" placeholder=\"Oil change, filters replaced, repairs, or other details\" required></textarea></div>\n</div></fieldset>\n<div class=\"savebar\"><div class=\"savebar-inner\"><p class=\"status\" id=\"maintenance-status\" role=\"status\" aria-live=\"polite\"></p><button type=\"submit\">Submit</button></div></div>\n</form>\n</section>\n</div>\n</main>\n<script>\nconst $ = id => document.getElementById(id);\nconst key = 'jwc-tickets-v1';\nconst fields = ['date','customer','job','truck','driver','hours','work'];\nlet pendingId = null;\nfunction all() {\n  try { const data = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(data) ? data : []; }\n  catch { return []; }\n}\nfunction clearForm() {\n  $('form').reset();\n  const now = new Date();\n  $('date').value = [now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-');\n}\n/* SHEETS_ADAPTER_START */\nfunction deliverTicket(ticket, success, failure) {\n  google.script.run.withSuccessHandler(success).withFailureHandler(failure).saveTickets([ticket]);\n}\n/* SHEETS_ADAPTER_END */\n$('form').onsubmit = event => {\n  event.preventDefault();\n  const button = $('form').querySelector('[type=\"submit\"]');\n  if (button.disabled) return;\n  const ticket = {id:pendingId || crypto.randomUUID()};\n  fields.forEach(field => ticket[field] = $(field).value);\n  ['jeep','booster','tridem'].forEach(field => ticket[field] = $(field).checked);\n  const tickets = all();\n  const index = tickets.findIndex(saved => saved.id === ticket.id);\n  if (index >= 0) tickets[index] = ticket; else tickets.push(ticket);\n  try { localStorage.setItem(key,JSON.stringify(tickets)); }\n  catch { $('status').textContent = 'Could not save on this device. Your form has been kept. Please try again.'; return; }\n  pendingId = ticket.id;\n  button.disabled = true;\n  button.textContent = 'Submitting\u2026';\n  $('status').textContent = 'Saving your ticket\u2026';\n  const finish = () => { button.disabled = false; button.textContent = 'Submit'; };\n  const failure = () => {\n    finish();\n    $('status').textContent = 'Saved on this device, but Google Sheets submission failed. Your form has been kept. Tap Submit to retry.';\n  };\n  try {\n    deliverTicket(ticket, result => {\n      pendingId = null;\n      clearForm();\n      finish();\n      $('status').textContent = result && result.localOnly\n        ? 'Saved on this device only. Google Sheets is not connected yet.'\n        : 'Submitted to Google Sheets. Ready for the next ticket.';\n    }, failure);\n  } catch { failure(); }\n};\nclearForm();\nfunction showAppView(view) {\n  const maintenance = view === 'maintenance';\n  $('ticket-view').hidden = maintenance;\n  $('maintenance-view').hidden = !maintenance;\n  document.querySelectorAll('[data-view]').forEach(link => {\n    if (link.dataset.view === (maintenance ? 'maintenance' : 'tickets')) link.setAttribute('aria-current','page');\n    else link.removeAttribute('aria-current');\n  });\n  window.scrollTo(0,0);\n}\ndocument.querySelectorAll('[data-view]').forEach(link => link.onclick = event => {event.preventDefault();showAppView(link.dataset.view);});\nshowAppView(document.body.dataset.initialView);\nlet maintenanceId = null;\nfunction resetMaintenance() {\n  $('maintenance-form').reset();\n  $('service-date').value = $('date').value;\n}\n/* MAINTENANCE_ADAPTER_START */\nfunction deliverMaintenance(entry, success, failure) {\n  google.script.run.withSuccessHandler(success).withFailureHandler(failure).saveMaintenance(entry);\n}\n/* MAINTENANCE_ADAPTER_END */\n$('maintenance-form').onsubmit = event => {\n  event.preventDefault();\n  const button = $('maintenance-form').querySelector('[type=\"submit\"]');\n  if (button.disabled) return;\n  const entry={id:maintenanceId || crypto.randomUUID(),date:$('service-date').value,truck:$('service-truck').value.trim(),service:$('service-type').value,performedBy:$('service-person').value.trim(),odometer:$('service-odometer').value,work:$('service-work').value.trim()};\n  if (!entry.truck || !entry.performedBy || !entry.work) { $('maintenance-status').textContent='Enter the truck, who did the work, and the work done.'; return; }\n  try {\n    const stored=JSON.parse(localStorage.getItem('jwc-maintenance-v1')||'[]');\n    if (!Array.isArray(stored)) throw new Error('Invalid backup');\n    const index=stored.findIndex(item=>item.id===entry.id);\n    if(index<0)stored.push(entry);else stored[index]=entry;\n    localStorage.setItem('jwc-maintenance-v1',JSON.stringify(stored));\n  } catch { $('maintenance-status').textContent='Could not save a backup on this device. Your form has been kept.';return; }\n  maintenanceId=entry.id;button.disabled=true;button.textContent='Submitting\u2026';\n  $('maintenance-status').textContent='Sending maintenance record\u2026';\n  const finish=()=>{button.disabled=false;button.textContent='Submit';};\n  const failure=()=>{finish();$('maintenance-status').textContent='Not sent to Google Sheets. Your form and local backup have been kept. Tap Submit to retry.';};\n  try {deliverMaintenance(entry,()=>{maintenanceId=null;resetMaintenance();finish();$('maintenance-status').textContent='Maintenance submitted to Google Sheets.';},failure);}catch{failure();}\n};\nresetMaintenance();\n</script></body></html>\n";
